    "horizon": { "from": "2027-01-01", "to": "2027-12-31" },
    "skipHolidays": true,
    "thresholds": { "warnFactor": 1.5, "maxFte": 0.6 }
  },
  "roles": [
    { "id": "role-po", "name": "Product Owner", "colour": "#1d4ed8" },
    { "id": "role-sm", "name": "Scrum Master", "colour": "#15803d" },
    { "id": "role-dev", "name": "Developer", "colour": "#b45309" }
